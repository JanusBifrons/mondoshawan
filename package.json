{
  "name": "mondoshawan",
  "version": "0.1.0",
  "private": true,
  "description": "Mondo: a desktop dashboard for local Claude Code sessions",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "electron . --dev",
    "start": "electron .",
    "server": "node scripts/serve.mjs",
    "server:dev": "node scripts/serve.mjs --dev",
    "build": "next build",
    "check:projects": "tsx scripts/check-projects.ts",
    "fake": "node scripts/fake-hook.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "hooks:uninstall": "node scripts/uninstall-hooks.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^45.2.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
