{
  "name": "mondoshawan",
  "version": "0.1.0",
  "private": true,
  "description": "Mondo: a desktop dashboard for local Claude Code sessions",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "electron . --dev",
    "start": "electron .",
    "server": "node scripts/serve.mjs",
    "server:dev": "node scripts/serve.mjs --dev",
    "build": "next build",
    "check:projects": "tsx scripts/check-projects.ts",
    "fake": "node scripts/fake-hook.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "hooks:uninstall": "node scripts/uninstall-hooks.mjs",
    "drive:status": "node --disable-warning=ExperimentalWarning --import tsx scripts/drive-status.ts",
    "drive:import": "node --disable-warning=ExperimentalWarning --import tsx scripts/drive-import.ts",
    "shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/create-shortcut.ps1",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "postinstall": "node node_modules/electron/install.js",
    "design": "node --disable-warning=ExperimentalWarning --import tsx scripts/design.ts",
    "restart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/restart-mondo.ps1"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "lucide-react": "^1.66.0",
    "next": "^16.4.3",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^45.2.1",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
